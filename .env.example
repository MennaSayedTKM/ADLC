# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Embeddings use Cohere Embed v4 on Amazon Bedrock by default (config.yaml
# embed_provider: bedrock). Locally that needs an AWS profile with Bedrock
# access — run `aws sso login --profile adlc` first. Not needed on AWS,
# where the server's instance role is used.
AWS_PROFILE=adlc

# Only when config.yaml has embed_provider: http — the ngrok URL printed by
# the Colab embedding-server notebook (embed_server/colab_embed_server.ipynb).
EMBED_API_URL=https://xxxx-xx-xx-xxx-xxx.ngrok-free.app

# Your OpenAI API key — used for requirements & change-request extraction,
# design alignment checks, reranking, and answer synthesis (gpt-4o).
OPENAI_API_KEY=sk-...

# Your Anthropic API key — not currently used (requirements extraction runs
# on OpenAI for now, see config.yaml's extraction_model); kept here so
# switching back to Claude is a one-line config change, not a re-setup.
ANTHROPIC_API_KEY=sk-ant-...

# Jina AI API key — required only when reranker=jina-reranker-v2-base-multimodal in config.yaml.
JINA_API_KEY=jina_...

# Confluence — optional, only for "Publish to Confluence" on approved requirements.
CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=...
CONFLUENCE_SPACE_KEY=...
