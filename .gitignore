# Secrets
.env

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Local app data — SQLite DB, FAISS index, tiles, and uploaded client
# documents. Never commit: it's client material and it's all rebuildable
# (alembic upgrade head + re-ingest). The app recreates the folder on start.
data/

# Test/demo scratch output (regenerated by backend/tests/seed_*.py)
backend/tests/_*scratch/

# Node / frontend
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# Personal editor / tool settings
.claude/settings.local.json
.vscode/
.idea/

# OS
Thumbs.db
Desktop.ini
.DS_Store
